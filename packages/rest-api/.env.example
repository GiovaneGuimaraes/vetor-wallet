PORT=3001
BRAPI_TOKEN=
SESSION_SECRET=change-this-to-a-random-secret-in-production
ALLOWED_ORIGIN=http://localhost:5173
SNAPSHOT_INTRADAY=false
ABACATEPAY_API_KEY=
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=
BILLING_ENABLED=false

# ── Open Finance via Pluggy (T-089b) ──────────────────────────────────────────
# Gate da integração: SÓ o valor `Staging` libera as rotas /api/pluggy/*.
# Ausente, vazia ou com qualquer outro valor = BLOQUEADO (fail closed) — o
# desfecho de um typo não pode ser oferecer a integração em produção sem
# contrato com a Pluggy. É independente de NODE_ENV de propósito.
ENVIRONMENT=Staging
# Credenciais da aplicação na Pluggy. O clientSecret NUNCA vai para o browser:
# o servidor o troca por um connect_token de ~30 min, e é o token que desce.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai

# ── Identidade no AWS Cognito (T-106) ─────────────────────────────────────────
# As TRÊS abaixo são obrigatórias: faltando qualquer uma, as rotas /api/auth/*
# respondem 503 AUTH_UNAVAILABLE em vez de tentar e quebrar torto (fail closed).
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Opcional, e depende de como o app client foi criado no pool. Se o app client
# TEM secret, toda chamada precisa levar SECRET_HASH; se NÃO tem, mandar o hash
# é erro. Deixe vazio quando o app client não tiver secret.
COGNITO_CLIENT_SECRET=
# Requisito do pool para o login funcionar: o app client precisa ter o fluxo
# ALLOW_USER_PASSWORD_AUTH habilitado (a tela de login é nossa, não Hosted UI).
