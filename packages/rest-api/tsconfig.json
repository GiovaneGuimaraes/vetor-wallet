{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@vetor-wallet/shared": ["../shared/src/index.ts"],
      "@vetor-wallet/db": ["../db/src/index.ts"],
      "@vetor-wallet/brapi-core": ["../brapi-core/src/index.ts"],
      "@vetor-wallet/cognito-core": ["../cognito-core/src/index.ts"],
      "@vetor-wallet/validation-core": ["../validation-core/src/index.ts"],
      "@vetor-wallet/subscription-core": ["../subscription-core/src/index.ts"],
      "@vetor-wallet/savings-core": ["../savings-core/src/index.ts"],
      "@vetor-wallet/expenses-core": ["../expenses-core/src/index.ts"],
      "@vetor-wallet/bank-import-core": ["../bank-import-core/src/index.ts"],
      "@vetor-wallet/portfolio-core": ["../portfolio-core/src/index.ts"],
      "@vetor-wallet/insights-core": ["../insights-core/src/index.ts"],
      "@vetor-wallet/auth-core": ["../auth-core/src/index.ts"],
      "@vetor-wallet/pluggy-core": ["../pluggy-core/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "references": [
    { "path": "../shared" },
    { "path": "../db" },
    { "path": "../brapi-core" },
    { "path": "../cognito-core" },
    { "path": "../validation-core" },
    { "path": "../subscription-core" },
    { "path": "../savings-core" },
    { "path": "../expenses-core" },
    { "path": "../bank-import-core" },
    { "path": "../portfolio-core" },
    { "path": "../insights-core" },
    { "path": "../auth-core" },
    { "path": "../pluggy-core" }
  ]
}
