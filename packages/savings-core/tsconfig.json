{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@vetor-wallet/query": ["../query/src/index.ts"],
      "@vetor-wallet/validation-core": ["../validation-core/src/index.ts"],
      "@vetor-wallet/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "references": [{ "path": "../query" }, { "path": "../shared" }, { "path": "../validation-core" }]
}
