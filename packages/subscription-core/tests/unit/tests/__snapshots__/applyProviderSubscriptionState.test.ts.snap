exports[`applyProviderSubscriptionState — renew o SQL da renovação (contrato com o banco) 1`] = `
[
  "SELECT user_id, plan_id, status, current_period_end FROM subscriptions WHERE abacate_subscription_id = $1",
  "SELECT * FROM plans WHERE id = $1",
  "UPDATE subscriptions SET current_period_end = $1, provider_status = $2, updated_at = $3 WHERE abacate_subscription_id = $4 AND status = 'active' AND current_period_end = $5 AND current_period_end <= $6",
]
`;

