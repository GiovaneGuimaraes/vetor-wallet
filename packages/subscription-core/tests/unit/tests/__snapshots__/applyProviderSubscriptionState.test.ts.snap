exports[`applyProviderSubscriptionState — activate o SQL da ativação (contrato com o banco) 1`] = `
[
  "UPDATE subscription_checkouts SET status = 'COMPLETED', abacate_subscription_id = $1, completed_at = $2 WHERE abacate_checkout_id = $3 AND status <> 'COMPLETED'",
  "SELECT user_id, plan_id FROM subscription_checkouts WHERE abacate_checkout_id = $1",
  "SELECT * FROM plans WHERE id = $1",
  "SELECT status, current_period_end, abacate_subscription_id FROM subscriptions WHERE user_id = $1",
  "INSERT INTO subscriptions (user_id, plan_id, status, current_period_end, provider, abacate_subscription_id, provider_status, canceled_at, created_at, updated_at) VALUES ($1, $2, 'active', $3, 'abacatepay_card', $4, $5, NULL, $6, $7) ON CONFLICT(user_id) DO UPDATE SET plan_id = excluded.plan_id, status = 'active', current_period_end = excluded.current_period_end, provider = excluded.provider, abacate_subscription_id = excluded.abacate_subscription_id, provider_status = excluded.provider_status, canceled_at = NULL, updated_at = excluded.updated_at WHERE subscriptions.status = $8 AND COALESCE(subscriptions.current_period_end, '') = $9 AND COALESCE(subscriptions.abacate_subscription_id, '') = $10",
]
`;

