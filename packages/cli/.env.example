# Path to the SQLite database created by the rest-api package.
# Relative to the cli/ directory when running via pnpm --filter vetor-wallet-cli.
# For future Turso migration: DATABASE_URL=libsql://your-db.turso.io?authToken=...
DATABASE_URL=file:../rest-api/data/wallet.db

# brapi.dev token (optional — higher rate limit with a token)
BRAPI_TOKEN=

# --- Pluggy / Open Finance (job pluggy:sync, T-087) ----------------------
# Credenciais da aplicação no painel da Pluggy (Meu Pluggy). NUNCA comite os
# valores: preencha só no .env local, que é git-ignored.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Id do item (a conexão com a instituição financeira). Desde a T-089a os items
# vivem no BANCO, por usuário (tabela pluggy_items): o `pluggy:sync` NÃO lê mais
# esta variável. Ela sobrou só como conveniência de bootstrap do `pluggy:link`,
# que aceita o itemId por argumento e cai nela quando o argumento não vem:
#   pnpm --filter vetor-wallet-cli pluggy:link            # usa PLUGGY_ITEM_ID
#   pnpm --filter vetor-wallet-cli pluggy:link <itemId>   # ignora a variável
PLUGGY_ITEM_ID=
# E-mail do usuário do app sobre o qual os comandos agem (as tabelas filtram por
# user_id e um job não tem sessão). É o DEFAULT do CLI: `--email=` no comando
# ganha dele. Sem default silencioso: sem nenhum dos dois, o comando falha.
PLUGGY_USER_EMAIL=
# Base da API (opcional; default https://api.pluggy.ai)
PLUGGY_API_URL=
