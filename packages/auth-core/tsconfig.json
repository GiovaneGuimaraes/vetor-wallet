{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@vetor-wallet/db": ["../db/src/index.ts"],
      "@vetor-wallet/shared": ["../shared/src/index.ts"],
      "@vetor-wallet/portfolio-core": ["../portfolio-core/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "references": [
    { "path": "../db" },
    { "path": "../shared" },
    { "path": "../portfolio-core" }
  ]
}
