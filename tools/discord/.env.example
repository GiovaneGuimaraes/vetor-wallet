# Copie para tools/discord/.env e preencha. O .env NAO e versionado (.gitignore:6).
# Nunca escreva estes valores em arquivo versionado, corpo de PR ou log.

# Bot -> Reset Token no Discord Developer Portal (aparece uma unica vez)
DISCORD_BOT_TOKEN=

# IDs dos 4 canais de texto (Modo desenvolvedor ligado -> botao direito -> Copiar ID)
