# Copie para tools/discord/.env e preencha. O .env NAO e versionado (.gitignore:6).
# Nunca escreva estes valores em arquivo versionado, corpo de PR ou log.

# Bot -> Reset Token no Discord Developer Portal (aparece uma unica vez)
DISCORD_BOT_TOKEN=

# Seu user ID (botao direito no seu nome -> Copiar ID). Usado por --mention e para
# distinguir a SUA reacao (decisao) da reacao do proprio bot (ack de leitura).
DISCORD_HUMAN_ID=

# IDs dos 5 canais (Modo desenvolvedor ligado -> botao direito no canal -> Copiar ID)
DISCORD_CHANNEL_BACKLOG=
DISCORD_CHANNEL_TODO_AI=
DISCORD_CHANNEL_TODO_HUMAN=
DISCORD_CHANNEL_DOCS_APP=
DISCORD_CHANNEL_AGENTIC_SYSTEM=
